# Tarot Luna - Backend Configuration
# Скопируйте этот файл как .env и заполните своими значениями

# ========== Telegram Bot ==========
BOT_TOKEN=your_bot_token_from_botfather
ADMIN_ID=your_telegram_id
BOT_USERNAME=YourBotUsername

# ========== Платежи ==========
ADMIN_CARD_NUMBER=0000 0000 0000 0000
CARD_NUMBER=0000 0000 0000 0000

# ========== OhMyGPT API ==========
OHMYGPT_API_KEY=your_ohmygpt_api_key

# ========== База данных ==========
DB_PATH=database.db
LOG_PATH=logs/bot.log

# ========== YooMoney ==========
YOOMONEY_BOT_TOKEN=your_yoomoney_token
YOOMONEY_WALLET=your_wallet_number
YOOMONEY_WEBHOOK_ENABLED=false
YOOMONEY_NOTIFICATION_SECRET=your_secret
YOOMONEY_WEBHOOK_HOST=0.0.0.0
YOOMONEY_WEBHOOK_PORT=8081
YOOMONEY_WEBHOOK_PATH=/yoomoney-webhook

# ========== API Server ==========
API_HOST=0.0.0.0
API_PORT=8080
